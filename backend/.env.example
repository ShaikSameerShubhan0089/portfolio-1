# Copy to .env and fill in real values. Never commit .env.

# Signs resume approval links. Use a long random string, e.g.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Brevo transactional email (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Verified Brevo sender address
SENDER_EMAIL=shaiksameershubhan71@gmail.com
# Where resume requests are delivered (defaults to SENDER_EMAIL)
OWNER_EMAIL=shaiksameershubhan71@gmail.com

# SMTP fallback, used when Brevo fails or BREVO_API_KEY is empty.
# For Gmail: turn on 2-Step Verification, then create a 16-character app password
# at https://myaccount.google.com/apppasswords (your normal Gmail password won't work).
SENDER_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Groq API key for the Laddu chat assistant (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: Groq chat model; change if Groq retires the default
GROQ_MODEL=openai/gpt-oss-120b

# Optional: force the host used in approval links, e.g. https://sameer-porfolio.onrender.com
PUBLIC_BASE_URL=

# Optional: local development only
FLASK_DEBUG=0

# Optional Supabase/Postgres analytics. Use Supabase's Session pooler URL.
DATABASE_URL=
# Credentials for /admin/analytics (do not reuse your Supabase password).
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD=

# Origin allowed to call the backend browser APIs
FRONTEND_ORIGIN=http://localhost:5500

# Public frontend origin used for canonical URLs and generated search metadata
SITE_URL=https://your-domain.example
